<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Boekhouding.Shared\Boekhouding.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ShipRipperServer</AssemblyName>
    <ApplicationIcon>../Boekhouding.Client/Assets/app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Geheimen: wel naar de bin-map (lokaal testen), nooit mee in de publicatie, zodat een update het bestand op de server niet overschrijft. -->
    <InternalsVisibleTo Include="Boekhouding.Tests" />
    <!-- Shopify-pixel: de server vult adres en sleutel in (endpoint /api/pixel/code). -->
    <EmbeddedResource Include="../../shopify/customer-events-pixel.js" LogicalName="customer-events-pixel.js" />
    <Content Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
