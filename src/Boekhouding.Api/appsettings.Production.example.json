// Kopieer dit bestand naar "appsettings.Production.json" (naast ShipRipperServer.exe op de server-pc,
// of in deze map om lokaal te testen) en vul de waarden in. Lege velden mag je laten staan.
// Dit bestand bevat geheimen: niet doorsturen, niet in de chat plakken, niet op een gedeelde schijf zetten.
// Waarden hier overschrijven die uit appsettings.json.
{
  "Security": {
    // Zelf te kiezen lange sleutel; dezelfde invullen bij Instellingen in de app op elke pc.
    "ApiKey": ""
  },
  "Company": {
    "Name": "",
    "Address": "",
    "VatNumber": "",
    "Email": ""
  },
  "Integrations": {
    // Pas op false zetten als de echte koppelingen klaar zijn (en begin dan met een lege database).
    "UseDummyData": true,

    // Shopify: het interne winkeladres (niet tcg-kiosk.be)
    "ShopifyShopDomain": "mptfwi-9e.myshopify.com",
    // Dev Dashboard-app (Instellingen van de app): Client ID en Client secret (shpss_...)
    "ShopifyClientId": "",
    "ShopifyClientSecret": "",
    // Alleen bij een oude custom app uit de Shopify-admin (shpat_...); anders leeg laten
    "ShopifyAccessToken": "",

    // Billit → API-sleutel + Party-ID. Voor testen: https://api.sandbox.billit.be
    "BillitBaseUrl": "https://api.billit.be",
    "BillitApiKey": "",
    "BillitPartyId": "",

    // Oude WooCommerce-shop (alleen-lezen sleutel), of leeg laten als we met een CSV-export werken
    "WooBaseUrl": "",
    "WooConsumerKey": "",
    "WooConsumerSecret": ""
  },
  "Stream": {
    // Woorden in de naam van de Shopify-verzendmethode voor spaarders, komma-gescheiden
    "SaverShippingKeyword": "live openen,livestream,spaar,sparen",
    // Sleutel die de Shopify-pixel meestuurt (dezelfde invullen in shopify/customer-events-pixel.js)
    "PixelKey": ""
  },
  "ComplaintsMailbox": {
    "Address": "",                    // bv. klachten@jouwdomein.be
    "DisplayName": "Ship & Ripper klantendienst",
    "ImapHost": "",                   // leeg = testklachten
    "ImapPort": 993,
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": ""                    // bij Gmail: app-wachtwoord
  }
}
