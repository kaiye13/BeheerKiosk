<Application x:Class="Boekhouding.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Boekhouding.Client"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Text" Color="#111827"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="Sidebar" Color="#111827"/>
        <SolidColorBrush x:Key="WarnBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="WarnText" Color="#92400E"/>
        <SolidColorBrush x:Key="MarginBrush" Color="#059669"/>
        <SolidColorBrush x:Key="InvoiceBrush" Color="#2563EB"/>

        <local:EnumLabelConverter x:Key="EnumLabel"/>
        <local:DecimalConverter x:Key="Dec"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Badges: verzending betaald (groen) / spaarder (oranje) / gratis (blauw) -->
        <DataTemplate x:Key="ShippingBadge">
            <Border x:Name="b" CornerRadius="4" Padding="7,1" HorizontalAlignment="Left" Background="#DCFCE7">
                <TextBlock x:Name="t" Text="{Binding ShippingKind, Converter={StaticResource EnumLabel}}" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShippingKind}" Value="Saver">
                    <Setter TargetName="b" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="t" Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShippingKind}" Value="Free">
                    <Setter TargetName="b" Property="Background" Value="#E0E7FF"/>
                    <Setter TargetName="t" Property="Foreground" Value="#3730A3"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="KindBadge">
            <Border x:Name="b" CornerRadius="4" Padding="7,1" HorizontalAlignment="Left" Background="#DCFCE7">
                <TextBlock x:Name="t" Text="{Binding Kind, Converter={StaticResource EnumLabel}}" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Saver">
                    <Setter TargetName="b" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="t" Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Free">
                    <Setter TargetName="b" Property="Background" Value="#E0E7FF"/>
                    <Setter TargetName="t" Property="Foreground" Value="#3730A3"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ChannelBadge">
            <Border x:Name="b" CornerRadius="4" Padding="7,1" HorizontalAlignment="Left" Background="#ECFCCB">
                <TextBlock x:Name="t" Text="{Binding Channel, Converter={StaticResource EnumLabel}}" FontSize="12" Foreground="#3F6212"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Channel}" Value="TikTokShop">
                    <Setter TargetName="b" Property="Background" Value="#FFE4E6"/>
                    <Setter TargetName="t" Property="Foreground" Value="#9F1239"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Artikelen van een order als klikbare link + "Details ›": opent het ordervenster (Ui.ShowOrderCommand). -->
        <DataTemplate x:Key="ItemsLink">
            <Button Command="{x:Static local:Ui.ShowOrderCommand}" CommandParameter="{Binding}" Cursor="Hand"
                    ToolTip="{Binding Items}" HorizontalContentAlignment="Stretch" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="2,2">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" x:Name="pill" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                        CornerRadius="10" Padding="7,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Details ›" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <TextBlock x:Name="text" Text="{Binding Items}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentDark}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="pill" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="WarnBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WarnBg}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="14,9" Margin="8,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1F2937"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F3"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Application.Resources>
</Application>
