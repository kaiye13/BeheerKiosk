<UserControl x:Class="Boekhouding.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Boekhouding.Client.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <v:MonthPicker x:Name="Month" Margin="0,0,12,0"/>
                <Button x:Name="SyncButton" Content="Synchroniseer nu" Click="Sync_Click"/>
                <Button Content="Factuur uploaden" Style="{StaticResource PrimaryButton}" Click="Upload_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Dashboard boekhouding" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="LastSyncText" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <Border x:Name="DummyBanner" Style="{StaticResource WarnBorder}" Visibility="Collapsed">
                <TextBlock Foreground="{StaticResource WarnText}" TextWrapping="Wrap"
                           Text="Testmodus: alle orders en Billit-facturen zijn dummy-data. Zet Integrations:UseDummyData op false op de server zodra de API-sleutels er zijn."/>
            </Border>
            <ItemsControl x:Name="Warnings">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WarnBorder}">
                            <TextBlock Text="{Binding}" Foreground="{StaticResource WarnText}" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid x:Name="Kpis" Columns="4" Margin="-6,0,-6,10"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Laatste bestellingen" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="OrdersGrid" BorderThickness="0" MouseDoubleClick="Order_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding OrderDate, StringFormat='dd/MM HH:mm'}" Width="90"/>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="70"/>
                            <DataGridTextColumn Header="Kanaal" Binding="{Binding Channel, Converter={StaticResource EnumLabel}}" Width="90"/>
                            <DataGridTextColumn Header="Klant" Binding="{Binding CustomerName}" Width="130"/>
                            <DataGridTemplateColumn Header="Wat (klik voor details)" Width="*" CellTemplate="{StaticResource ItemsLink}"/>
                            <DataGridTextColumn Header="Totaal" Binding="{Binding TotalIncl, StringFormat=C}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Btw" Binding="{Binding VatDue, StringFormat=C}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Laatste facturen (Billit + manueel)" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="InvoicesGrid" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yy'}" Width="80"/>
                            <DataGridTextColumn Header="Bron" Binding="{Binding Source}" Width="75"/>
                            <DataGridTextColumn Header="Leverancier" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="Incl." Binding="{Binding GrossAmount, StringFormat=C}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
