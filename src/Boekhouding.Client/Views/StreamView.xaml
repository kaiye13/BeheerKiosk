<UserControl x:Class="Boekhouding.Client.Views.StreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Boekhouding.Client.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kop -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="StartPanel" Orientation="Horizontal">
                    <TextBox x:Name="TitleBox" Width="200" Margin="0,0,8,0" ToolTip="Titel van de stream"/>
                    <TextBlock Text="Doel €" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource Muted}"/>
                    <TextBox x:Name="GoalBox" Width="70" Margin="0,0,8,0" Text="2000"/>
                    <Button x:Name="StartButton" Content="▶ Start stream" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0"/>
                </StackPanel>
                <Button x:Name="StopButton" Content="■ Stop stream" Click="Stop_Click" Margin="0" Visibility="Collapsed"
                        Background="#FEE2E2" BorderBrush="#FCA5A5" Foreground="#991B1B"/>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="LiveDot" Background="#DC2626" CornerRadius="4" Padding="8,2" Margin="0,4,10,0" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Text="LIVE" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <TextBlock x:Name="HeaderTitle" Text="Live stream" Style="{StaticResource PageTitle}"/>
                </StackPanel>
                <TextBlock x:Name="HeaderSub" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </DockPanel>

        <!-- Doel + kerncijfers + topproducten -->
        <Grid Grid.Row="1" Margin="0,0,0,12" Height="190">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Width="110">
                        <TextBlock Text="Streamdoel" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Rectangle Width="10" Height="10" Fill="#5E8E3E" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Shopify" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="LegendShopify" FontWeight="SemiBold" Margin="16,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Rectangle Width="10" Height="10" Fill="#E11D48" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                            <TextBlock Text="TikTok Shop" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="LegendTikTok" FontWeight="SemiBold" Margin="16,0,0,8"/>
                        <TextBlock x:Name="LegendRemaining" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <v:DonutChart x:Name="Donut"/>
                </DockPanel>
            </Border>
            <UniformGrid x:Name="Kpis" Grid.Column="2" Columns="4" Rows="2" Margin="-4"/>
            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Best verkocht deze stream" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="TopProducts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat='{}{0}×'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,8,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Rip-tool | bestellingen | klanten + shop -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                        <Button DockPanel.Dock="Right" Content="⟳" ToolTip="Rip-tool herladen" Click="Reload_Click" Padding="10,4" Margin="6,0,0,0"/>
                        <TextBlock Text="Rip-tool" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="#F9FAFB" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="ManualPrint" Content="🖨 Print label" Click="ManualPrint_Click" Margin="0"/>
                            <TextBox x:Name="ManualName" Margin="0,0,8,0" ToolTip="Naam voor het label (Nu rippen komt hier automatisch). Enter = printen." KeyDown="ManualName_KeyDown"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" x:Name="PrintStatusBar" Background="#ECFDF5" Padding="12,6" Visibility="Collapsed">
                        <TextBlock x:Name="PrintStatus" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <Grid>
                        <wv2:WebView2 x:Name="RipTool"/>
                        <TextBlock x:Name="RipToolError" Visibility="Collapsed" Margin="16" TextWrapping="Wrap" Foreground="{StaticResource WarnText}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                        <TextBlock DockPanel.Dock="Right" x:Name="OrdersSummary" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Text="Wie bestelt wat" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <DataGrid x:Name="OrdersGrid" BorderThickness="0,1,0,0" RowHeight="34" MouseDoubleClick="Order_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tijd" Binding="{Binding OrderDate, StringFormat='HH:mm'}" Width="52"/>
                            <DataGridTextColumn Header="Klant" Binding="{Binding CustomerName}" Width="120" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Kanaal" Width="95" CellTemplate="{StaticResource ChannelBadge}"/>
                            <DataGridTemplateColumn Header="Wat (klik voor details)" Width="*" CellTemplate="{StaticResource ItemsLink}"/>
                            <DataGridTextColumn Header="Totaal" Binding="{Binding TotalIncl, StringFormat=C}" Width="78" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Header="Verzending" Width="140" CellTemplate="{StaticResource ShippingBadge}"/>
                            <DataGridTemplateColumn Header="Label" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="✓" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Visibility="{Binding LabelPrinted, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.3*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Klanten: verzenders &amp; spaarders" Style="{StaticResource SectionTitle}" Margin="12,10,12,8"/>
                        <DataGrid x:Name="CustomersGrid" BorderThickness="0,1,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Klant" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Ord." Binding="{Binding Orders}" Width="40" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Totaal" Binding="{Binding Total, StringFormat=C0}" Width="62" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTemplateColumn Header="Type" Width="140" CellTemplate="{StaticResource KindBadge}"/>
                                <DataGridTextColumn Header="Spaar" Binding="{Binding OpenSaverOrders}" Width="50" ElementStyle="{StaticResource RightCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                    <TabControl BorderThickness="0" Padding="0">
                        <TabItem x:Name="ShoppersTab" Header="Nu in de shop">
                            <Grid>
                            <StackPanel x:Name="ShoppersHint" Visibility="Collapsed" Margin="12" Panel.ZIndex="1" Background="White">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"
                                           Text="Nog niet gekoppeld. Live bezoekers verschijnen hier zodra de Shopify-pixel geïnstalleerd is en de server via internet bereikbaar is."/>
                                <Button x:Name="PixelButton" Content="Pixelcode kopiëren voor Shopify" Click="PixelCode_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="ShoppersGrid" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Wie" Binding="{Binding CustomerName, TargetNullValue='Anoniem'}" Width="*"/>
                                    <DataGridTextColumn Header="Waar" Binding="{Binding Stage, Converter={StaticResource EnumLabel}}" Width="115"/>
                                    <DataGridTextColumn Header="Mandje" Binding="{Binding CartValue, StringFormat=C0}" Width="58" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Min." Binding="{Binding MinutesInShop}" Width="40" ElementStyle="{StaticResource RightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="AbandonedTab" Header="Verlaten checkouts">
                            <DataGrid x:Name="AbandonedGrid" BorderThickness="0" MouseDoubleClick="Abandoned_DoubleClick"
                                      ToolTip="Dubbelklik: herstel-link van de checkout openen (kun je naar de klant sturen)">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tijd" Binding="{Binding CreatedAt, StringFormat='HH:mm'}" Width="46"/>
                                    <DataGridTextColumn Header="Wie" Binding="{Binding CustomerName, TargetNullValue='Gast'}" Width="70"/>
                                    <DataGridTextColumn Header="Wat" Binding="{Binding Items}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding Items}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Bedrag" Binding="{Binding Total, StringFormat=C0}" Width="60" ElementStyle="{StaticResource RightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
