<Window x:Class="Boekhouding.Client.Views.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bestelling" Width="820" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <DockPanel Margin="20">
        <!-- Kop -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ContentControl x:Name="ChannelBadge" ContentTemplate="{StaticResource ChannelBadge}" Margin="0,0,8,0"/>
                <ContentControl x:Name="ShippingBadge" ContentTemplate="{StaticResource ShippingBadge}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="OrderTitle" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="OrderSub" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </DockPanel>

        <!-- Klant / verzending / status -->
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="-6,0,-6,12">
            <Border Style="{StaticResource CardBorder}" Margin="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="Klant" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="Customer" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CustomerEmail" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="Verzending" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="ShippingMethod" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ShippingCost" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="Stage" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Tracking" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TrackingLink" Margin="0,2,0,0" Visibility="Collapsed">
                        <Hyperlink Click="Tracking_Click">Tracking openen</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Totalen -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="Total" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="Totals" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Notes" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarnText}" Visibility="Collapsed"/>

        <!-- Artikelen -->
        <Border Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="Lines" BorderThickness="0" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Aantal" Binding="{Binding Quantity, StringFormat='{}{0}×'}" Width="60" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Artikel" Binding="{Binding Title}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                    <DataGridTextColumn Header="Prijs/st" Binding="{Binding UnitPriceIncl, StringFormat=C}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Totaal" Binding="{Binding TotalIncl, StringFormat=C}" Width="85" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Uit voorraad" Binding="{Binding StockSource}" Width="150"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="34"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
