<UserControl x:Class="Boekhouding.Client.Views.ComplaintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ShowResolved" Content="Opgeloste tonen" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button x:Name="CheckMailButton" Content="✉ Mailbox controleren" Click="CheckMail_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Klachten" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="Summary" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <ListBox x:Name="List" BorderThickness="0" SelectionChanged="List_SelectionChanged" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Border x:Name="dot" DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="#DC2626" Margin="0,6,10,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LastActivity, StringFormat='dd/MM HH:mm'}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding FromName}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumLabel}}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding OrderNumber, StringFormat=' · order {0}'}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding MessageCount, StringFormat=' · {0} bericht(en)'}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="InProgress"><Setter TargetName="dot" Property="Background" Value="#F59E0B"/></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="WaitingForCustomer"><Setter TargetName="dot" Property="Background" Value="#3B82F6"/></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Resolved"><Setter TargetName="dot" Property="Background" Value="#10B981"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid x:Name="Detail" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailSubject" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailFrom" Style="{StaticResource MutedText}" Margin="0,2,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="StatusBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gekoppelde order" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="OrderBox" DisplayMemberPath="Label"/>
                            </StackPanel>
                            <Button Grid.Column="3" x:Name="SaveMeta" Content="Opslaan" Click="SaveMeta_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                        </Grid>
                        <Border x:Name="OrderCard" Background="#F9FAFB" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock x:Name="OrderInfo" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" x:Name="ThreadScroll" Margin="0,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Thread">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="bubble" Background="#F3F4F6" CornerRadius="8" Padding="12,8" Margin="0,0,80,8" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding At, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding SendError, StringFormat='⚠ Niet verstuurd: {0}'}" FontSize="11" Foreground="#B91C1C" TextWrapping="Wrap"
                                                       x:Name="err"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Outgoing}" Value="True">
                                            <Setter TargetName="bubble" Property="Background" Value="#DBEAFE"/>
                                            <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="bubble" Property="Margin" Value="80,0,0,8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SendError, TargetNullValue=''}" Value="">
                                            <Setter TargetName="err" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBox x:Name="ReplyBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" x:Name="SendButton" Content="Antwoord versturen" Style="{StaticResource PrimaryButton}" Click="Send_Click" Margin="0"/>
                            <ComboBox DockPanel.Dock="Right" x:Name="AfterSendBox" Width="190" Margin="0,0,8,0" ToolTip="Status na versturen"/>
                            <TextBlock x:Name="ReplyHint" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
