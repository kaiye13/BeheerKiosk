<UserControl x:Class="Boekhouding.Client.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Boekhouding.Client.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AttachButton" Content="Bestand koppelen…" Click="Attach_Click"/>
                <Button x:Name="OpenButton" Content="Bestand openen" Click="OpenFile_Click"/>
                <Button Content="Nieuwe factuur" Style="{StaticResource PrimaryButton}" Click="New_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Aankoopfacturen" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Automatisch uit Billit en manueel ingevoerd. Koppel het PDF-bestand aan facturen zonder bestand."/>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Margin="0,0,16,4">
                    <TextBlock Text="Periode (factuurdatum)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <v:PeriodPicker x:Name="Period"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,4">
                    <TextBlock Text="Leverancier" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="SupplierFilter" Width="220" IsEditable="True" IsTextSearchEnabled="False"
                              ToolTip="Kies of typ (een deel van) de naam, het btw-nummer of factuurnummer"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,4">
                    <TextBlock Text="Bedrag incl. van – tot" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="MinAmount" Width="80"/>
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox x:Name="MaxAmount" Width="80"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,16,4">
                    <TextBlock Text="Btw-type" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="VatFilter" Width="200"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,4">
                    <TextBlock Text="Bron" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="SourceFilter" Width="110"/>
                </StackPanel>
                <Button Content="Filters wissen" Click="Reset_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </WrapPanel>
        </Border>

        <!-- Totalen van de selectie -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,10,0,0">
            <TextBlock x:Name="Totals" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="Grid" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="90"/>
                    <DataGridTextColumn Header="Bron" Binding="{Binding Source}" Width="70"/>
                    <DataGridTextColumn Header="Leverancier" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="Factuurnr" Binding="{Binding InvoiceNumber}" Width="130"/>
                    <DataGridTextColumn Header="Land" Binding="{Binding Country}" Width="45"/>
                    <DataGridTextColumn Header="Btw-type" Binding="{Binding VatType, Converter={StaticResource EnumLabel}}" Width="190"/>
                    <DataGridTextColumn Header="Excl." Binding="{Binding NetAmount, StringFormat=C}" Width="95" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Btw" Binding="{Binding VatAmount, StringFormat=C}" Width="85" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Incl." Binding="{Binding GrossAmount, StringFormat=C}" Width="95" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Voorraad" Binding="{Binding LineCount}" Width="70" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Bestand" Binding="{Binding FileName}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
