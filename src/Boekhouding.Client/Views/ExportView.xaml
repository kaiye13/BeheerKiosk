<UserControl x:Class="Boekhouding.Client.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Boekhouding.Client.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <v:PeriodPicker x:Name="Period" Margin="0,0,12,0"/>
                <Button x:Name="ExportButton" Content="Exporteer naar Excel" Style="{StaticResource PrimaryButton}" Click="Export_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Export boekhouding" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Btw-afrekening per maand: marge + factuur + aankopen. Indicatief, laten nakijken door de boekhouder."/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="Warnings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WarnBorder}">
                                <TextBlock Text="{Binding}" Foreground="{StaticResource WarnText}" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="BalanceCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock x:Name="BalanceValue" DockPanel.Dock="Right" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock x:Name="BalanceLabel" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BalanceSub" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <UniformGrid x:Name="Sections" Columns="2" Margin="-6,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
