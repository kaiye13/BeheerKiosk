<Window x:Class="Boekhouding.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ship &amp; Ripper – Boekhouding" Height="860" Width="1400" MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Background="{StaticResource Sidebar}">
            <StackPanel DockPanel.Dock="Top" Margin="22,24,16,24">
                <TextBlock Text="Ship &amp; Ripper" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Boekhouding" Foreground="#9CA3AF"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="16">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,6">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#9CA3AF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Verbinden…" Foreground="#9CA3AF" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="ServerText" Foreground="#6B7280" FontSize="11" Margin="6,0,0,10" TextWrapping="Wrap"/>
                <Button Content="Instellingen" Click="Settings_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151"/>
            </StackPanel>

            <StackPanel x:Name="Nav">
                <TextBlock Text="STREAM" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="22,0,0,4"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="stream" Content="Live stream" Checked="Nav_Checked" IsChecked="True"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="followup" Content="Orderopvolging" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="complaints" Content="Klachten" Checked="Nav_Checked"/>
                <TextBlock Text="BOEKHOUDING" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="22,16,0,4"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="dashboard" Content="Dashboard" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="orders" Content="Verkopen" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="products" Content="Producten" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="overview" Content="Overzicht alles" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="newpurchase" Content="Nieuwe invoer" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="agreements" Content="Verkoopovereenkomsten" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="invoices" Content="Facturen" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavButton}" Tag="export" Content="Export boekhouding" Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>

        <ContentControl x:Name="Host" Grid.Column="1" Margin="28,24,28,20"/>
    </Grid>
</Window>
