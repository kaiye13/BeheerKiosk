<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Boekhouding.Shared\Boekhouding.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ShipRipperBoekhouding</AssemblyName>
    <Product>Ship &amp; Ripper Boekhouding</Product>
    <Version>0.1.0</Version>
    <!-- Logo van TCG Kiosk voor de exe, de taakbalk en de vensters -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/tcg-kiosk.png" />
  </ItemGroup>

</Project>
